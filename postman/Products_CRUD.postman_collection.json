{
  "info": {
    "name": "Products CRUD API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "newId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. GET - List all products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "2. POST - Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"Pixel 9\",\n  \"brand\": \"Google\",\n  \"category\": \"Smartphone\",\n  \"price\": 799,\n  \"stock_quantity\": 10,\n  \"rating\": 4.5,\n  \"description\": \"Created from Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.id) pm.collectionVariables.set('newId', j.id);",
              "pm.test('201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. GET - Get one (new record)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{newId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{newId}}"
          ]
        }
      }
    },
    {
      "name": "4. PUT - Update product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{newId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{newId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"Pixel 9 Pro\",\n  \"brand\": \"Google\",\n  \"category\": \"Smartphone\",\n  \"price\": 999,\n  \"stock_quantity\": 8,\n  \"rating\": 4.6,\n  \"description\": \"Updated from Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. DELETE - Delete product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{newId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{newId}}"
          ]
        }
      }
    }
  ]
}